{
  "name": "football-bet-pos",
  "version": "0.1.0",
  "private": true,
  "main": "dist/electron/main/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": { "react": "^19.2.3", "react-dom": "^19.2.3" },
  "devDependencies": {
    "@types/node": "^24.10.1", "@types/react": "^19.2.7", "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.1.1", "concurrently": "^9.2.1", "cross-env": "^10.1.0",
    "electron": "^43.0.0", "electron-builder": "^26.0.12", "typescript": "^5.9.3", "vite": "^7.2.6", "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.footballbet.pos",
    "productName": "Football Bet POS",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "asar": true,
    "win": { "target": "nsis" }
  }
}
